# Monday API (existing)
MONDAY_API_TOKEN=your_monday_token
MONDAY_HUB_WORKSPACE_ID=16379553

# Dashboard login — shared team account (Phase 1)
DASHBOARD_AUTH_EMAIL=integrations@calidads.net
DASHBOARD_AUTH_PASSWORD=choose_a_strong_password

# Session signing secret — generate with: openssl rand -base64 32
AUTH_SECRET=replace_with_random_32_char_secret

# Vercel Cron — generate with: openssl rand -base64 32
CRON_SECRET=replace_with_random_32_char_secret

# Reliable sync — GitHub Actions trigger (Settings → Developer settings → PAT, scopes: repo + workflow)
GITHUB_SYNC_TOKEN=github_pat_xxxxxxxx
GITHUB_REPO=Calidad96/calidad-soc-stos-dashboard
SYNC_APP_URL=https://calidad-soc-stos-dashboard.vercel.app
